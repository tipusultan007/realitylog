APP_NAME=RealityLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Upload scanning. "null" validates type and size only; "clamav" also scans
# contents using ClamAV's clamdscan binary.
UPLOAD_SCANNER=null
CLAMAV_BINARY=clamdscan

# Local AI. OCR, transcription, and embeddings run on this server.
# Install Python packages with: python -m pip install -r scripts/ai/requirements.txt
# Models are downloaded on first use. Set paths explicitly if they are not on PATH.
LOCAL_AI_ENABLED=true
# AI_PYTHON=C:\path\to\ai-venv\Scripts\python.exe
# TESSERACT_BINARY=tesseract
# TESSDATA_DIR=storage/app/tessdata
OCR_LANGUAGES=eng+ben
OCR_MAX_PAGES=10
# FFMPEG_BINARY=ffmpeg
# PDFTOPPM_BINARY=pdftoppm
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
# Cosine similarity below this is treated as unrelated.
SEMANTIC_SEARCH_THRESHOLD=0.45
SEMANTIC_SCORE_WEIGHT=10
RELATIONSHIP_SIMILARITY_THRESHOLD=0.40
RELATIONSHIP_SUGGESTION_LIMIT=3
LOCAL_AI_TIMEOUT=600

# Optional database client binaries for backup:database.
# MYSQLDUMP_BINARY=mysqldump
# PG_DUMP_BINARY=pg_dump

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
